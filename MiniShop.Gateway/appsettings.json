{
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}",
          "Methods": [ "GET", "POST" ]
        }
      },

      "orders-route": {
        "ClusterId": "orders-cluster",
        "RateLimiterPolicy": "orderLimiter",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }

      }
    },

    "Clusters": {
      "products-cluster": {
        "HealthCheck": {

          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7001/"
          }
        }
      },

      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:7002/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}